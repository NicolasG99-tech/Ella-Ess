# Kopiere diese Datei nach .env und passe sie bei Bedarf an.
# Alle Werte hier sind unbedenkliche lokale Entwicklungs-Defaults, keine Produktionsgeheimnisse.

# PostgreSQL (siehe docker-compose.yml)
DATABASE_URL="postgresql://lese_app:lese_app_dev_only@localhost:5432/lese_app?schema=public"

# --- Alternative für Staging/Produktion: Supabase (gehostetes PostgreSQL) ---
# Nur relevant, wenn NICHT gegen die lokale Docker-DB entwickelt wird. Für die
# lokale Entwicklung die obige DATABASE_URL (Docker) verwenden und diesen
# Block auskommentiert lassen.
#
# Supabase stellt zwei unterschiedliche Connection Strings bereit
# (Dashboard: Project Settings → Database → Connection string):
#
# 1. DATABASE_URL = "Connection pooling" / Transaction-Modus, Port 6543,
#    Query-Parameter "pgbouncer=true". Für Laufzeit-Queries der App (das ist
#    die von src/lib/server/db.ts zur Laufzeit genutzte Variable) — geeignet
#    für viele parallele/serverlose Verbindungen, aber PgBouncer im
#    Transaction-Modus unterstützt kein DDL/keine Prepared Statements
#    zuverlässig, daher NICHT für Migrationen verwenden.
# 2. DIRECT_URL = "Direct connection", Port 5432. Ausschließlich für
#    Schema-Migrationen (prisma migrate) genutzt, siehe prisma.config.ts.
#
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Auth.js
# Erzeuge einen echten Wert mit: npx auth secret
AUTH_SECRET="dev-only-insecure-secret-change-me"
AUTH_TRUST_HOST="true"

# Feature-Flags / Provider
# "mock" ist der Standard und im MVP der einzige ohne weitere Voraussetzungen
# nutzbare Spracherkennungs-Provider. "azure" ist implementiert, überträgt
# aber echtes Kinderaudio an Azure — NICHT aktivieren ohne abgeschlossenen
# Datenschutz-Review (AVV, Einwilligung, EU-Datenzone), siehe den
# privacy-security- und speech-provider-Agenten sowie docs/SECURITY.md.
SPEECH_PROVIDER="mock"

# Nur nötig, wenn SPEECH_PROVIDER="azure":
# Azure AI Speech Ressourcen-Schlüssel (Portal: "Schlüssel und Endpunkt").
AZURE_SPEECH_KEY=""
# Region der Speech-Ressource — ENTSCHIEDEN: "germanywestcentral" (EU-/
# deutsche Datenzone), nicht nur ein Beispiel unter mehreren. Nicht-persistente
# Verarbeitung + EU-/deutsche Datenzone ist die festgelegte primäre
# Schutzmaßnahme für Kinderaudio bei diesem Provider (siehe docs/SECURITY.md,
# "Optionaler echter Spracherkennungs-Provider (Azure)" — Formant-Verschiebung
# als Alternative/Ergänzung wurde dort bewusst geprüft und verworfen).
AZURE_SPEECH_REGION="germanywestcentral"
# BCP-47-Sprachcode, Standard "de-DE" wenn nicht gesetzt.
AZURE_SPEECH_LANGUAGE="de-DE"

# Optionale, zusätzliche Datenschutz-Maßnahme (Defense-in-Depth, siehe
# src/lib/providers/speech/audioPreprocessing.ts) — leichte Tonhöhen-/
# Tempo-Verschiebung vor der Übertragung an einen echten Provider, z.B.
# "1.06" für +6%. Leer/nicht gesetzt = keine Veränderung. WICHTIG: ist KEINE
# verlässliche Anonymisierung der Stimme als biometrisches Merkmal, siehe
# Kommentar in audioPreprocessing.ts — kein Ersatz für AVV/Einwilligung.
SPEECH_PRIVACY_PITCH_SHIFT_RATE=""

# E-Mail-Versand (Passwort-Reset). Ohne BREVO_API_KEY: Fallback auf
# Server-Log wie bisher (siehe src/lib/server/email.ts) — unbedenklich für
# lokale Entwicklung. Brevo (EU-/französisches Unternehmen) gewählt, um bei
# der EU-Datenresidenz-Linie zu bleiben (Hetzner/Supabase/Azure-EU-Zone).
BREVO_API_KEY=""
EMAIL_FROM_ADDRESS=""
EMAIL_FROM_NAME="Lese-Abenteuer"

# Basis-URL der App, um absolute Links in E-Mails zu bauen (z.B.
# Passwort-Reset-Link). Lokal Standard "http://localhost:3000", wenn nicht
# gesetzt. In Produktion auf die echte Domain setzen.
APP_BASE_URL="http://localhost:3000"

# Demo-/Seed-Zugang (siehe README.md) — niemals produktiv verwenden
DEMO_PARENT_EMAIL="parent@example.com"
DEMO_PARENT_PASSWORD="Demo-Passwort123!"
DEMO_ADMIN_EMAIL="admin@example.com"
DEMO_ADMIN_PASSWORD="Demo-Admin-Passwort123!"
